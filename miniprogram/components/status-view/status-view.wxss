.status { display: flex; min-height: 360rpx; padding: 48rpx 28rpx; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.symbol { display: flex; width: 76rpx; height: 76rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(177,194,226,.18); border-radius: 50%; color: #d9bb72; font-size: 36rpx; }
.title { margin-top: 24rpx; color: #f5f7fb; font-size: 26rpx; font-weight: 600; }
.description { max-width: 520rpx; margin-top: 12rpx; color: #96a0b8; font-size: 22rpx; line-height: 1.6; }
.action { margin-top: 28rpx; min-width: 180rpx; border-radius: 8rpx; background: #d9bb72; color: #15130d; font-size: 23rpx; }
.action::after { border: 0; }
.loader { width: 58rpx; height: 58rpx; border: 5rpx solid rgba(217,187,114,.18); border-top-color: #d9bb72; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

