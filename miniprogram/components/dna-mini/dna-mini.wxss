:host { display:block; width:110rpx; height:70rpx; flex:none; pointer-events:none; }
.dna { position:relative; width:100%; height:100%; }
.rung { position:absolute; top:0; width:0; height:100%; }
.bridge { position:absolute; left:0; width:1rpx; background:rgba(177,194,226,.28); }
.dot { position:absolute; left:0; width:8rpx; height:8rpx; border-radius:50%; transform:translate(-50%, -50%); }
.dot.first { background:#d9bb72; }
.dot.second { background:#9b87e8; }
.violet .dot.first { background:#9b87e8; }
.violet .dot.second { background:#62c7d9; }

