<view wx:if="{{visible}}" class="mask" role="dialog" aria-modal="true" aria-label="隐私保护提示">
  <view class="dialog panel">
    <text class="title">隐私保护提示</text>
    <text class="body">当前版本无需登录或上传材料。收藏、画布和验证进度只保存在本机；你可以先查看隐私说明，再决定是否继续。</text>
    <view class="links"><text bindtap="openPolicy">查看隐私说明</text></view>
    <view class="actions">
      <button class="cancel" bindtap="decline">暂不使用</button>
      <button class="accept" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="accept" bindtap="accept">同意并继续</button>
    </view>
  </view>
</view>
