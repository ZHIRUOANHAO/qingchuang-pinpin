:host { display: block; width: 100%; height: 100%; }
.scene-shell, .webgl, .fallback { position: relative; width: 100%; height: 100%; }
.scene-shell { overflow: hidden; background: transparent; }
.snapshot { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
.loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; background: rgba(5,8,18,.22); color: #96a0b8; font-size: 21rpx; }
.loader { width: 48rpx; height: 48rpx; border: 4rpx solid rgba(217,187,114,.18); border-top-color: #d9bb72; border-radius: 50%; animation: spin 1s linear infinite; }
.fallback-note { position: absolute; right: 14rpx; bottom: 14rpx; padding: 6rpx 10rpx; border-radius: 4rpx; background: rgba(5,8,18,.62); color: #7f8aa6; font-size: 18rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
