:host { display: block; width: 100%; min-width: 0; }
.dna-view { box-sizing: border-box; width: 100%; background: #05080e; border-top: 1px solid rgba(177,194,226,.16); border-bottom: 1px solid rgba(177,194,226,.16); }
.axis { box-sizing: border-box; display: flex; align-items: center; gap: 10px; min-height: 38px; padding: 10px 16px 0; }
.axis-label { font-size: 10px; line-height: 16px; white-space: nowrap; }
.axis-divider { width: 24px; height: 1px; background: rgba(177,194,226,.2); flex-shrink: 0; }
.viewport { position: relative; width: 100%; height: 50vh; min-height: 320px; max-height: 430px; }
.empty { display: flex; height: 100%; align-items: center; justify-content: center; }
.empty-title { font-size: 15px; color: #96a0b8; }
.toolbar { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 70px; padding: 8px 16px 14px; }
.score-label { display: block; font-size: 10px; line-height: 16px; color: #96a0b8; }
.score-value { font-size: 30px; font-weight: 650; color: #efd892; }
.score-total { font-size: 10px; color: #7f8aa6; }
.controls { display: flex; flex-shrink: 0; gap: 6px; }
.tool { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: 42px; min-width: 0; height: 42px; margin: 0; padding: 0; border: 1px solid rgba(177,194,226,.22); border-radius: 4px; background: #0b111c; color: #e8efff; font-size: 24px; line-height: 1; }
.tool::after { border: 0; }
.tool-image { display: block; width: 20px; height: 20px; pointer-events: none; }
.controls.disabled { opacity: .4; }
.legend { box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 10px 16px; padding: 12px 16px; border-top: 1px solid rgba(177,194,226,.12); }
.legend-item { display: flex; align-items: center; gap: 6px; }
.dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.legend-label { font-size: 10px; line-height: 16px; color: #aab4c7; }
