page {
  --space: #050812;
  --surface: rgba(13, 20, 38, 0.88);
  --surface-strong: #111a2d;
  --line: rgba(177, 194, 226, 0.16);
  --text: #f5f7fb;
  --muted: #96a0b8;
  --gold: #d9bb72;
  --violet: #9b87e8;
  --cyan: #62c7d9;
  --success: #65c799;
  --danger: #ef7d83;
  min-height: 100%;
  background: var(--space);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
  letter-spacing: 0;
}

view, text, button, input, textarea, scroll-view, canvas, image {
  box-sizing: border-box;
}

button::after { border: 0; }

.page-shell {
  position: relative;
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 24rpx) 28rpx calc(env(safe-area-inset-bottom) + 32rpx);
  overflow: hidden;
}

.page-scroll { height: 100vh; }
.page-shell.custom-page { padding-top: 0; }

.nav-bar {
  position: relative;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
}

.brand-block { min-width: 0; }
.brand { font-size: 34rpx; font-weight: 650; color: var(--text); }
.brand-sub { margin-top: 4rpx; font-size: 20rpx; color: var(--muted); }

.icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px !important;
  min-width: 42px;
  flex-shrink: 0;
  margin: 0 !important;
  height: 42px;
  padding: 0;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: rgba(15, 23, 42, 0.72);
  color: var(--text);
  font-size: 28rpx;
}

.section { position: relative; z-index: 2; margin-top: 36rpx; }
.section-head { display: flex; align-items: end; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 620; color: var(--text); }
.section-note, .muted { font-size: 22rpx; color: var(--muted); }

.panel {
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: var(--surface);
  box-shadow: 0 18rpx 64rpx rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(20rpx);
}

.primary-button, .secondary-button, .danger-button {
  display: flex;
  width: 100% !important;
  min-width: 0;
  margin: 0 !important;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  min-height: 80rpx;
  padding: 12px;
  border-radius: 8rpx;
  font-size: 13px;
  line-height: 1.45;
  white-space: normal;
  word-break: break-word;
  font-weight: 600;
}

.primary-button { background: var(--gold); color: #15130d; }
.secondary-button { border: 1rpx solid var(--line); background: rgba(13,20,38,.8); color: var(--text); }
.danger-button { border: 1rpx solid rgba(239,125,131,.32); background: rgba(239,125,131,.12); color: #ffb2b6; }
.primary-button[disabled], .secondary-button[disabled] { opacity: .42; }

.chip-row { display: flex; gap: 12rpx; white-space: nowrap; }
.chip {
  display: inline-flex;
  align-items: center;
  min-height: 56rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  background: rgba(13, 20, 38, 0.72);
  color: var(--muted);
  font-size: 22rpx;
}
.chip.active { border-color: rgba(217,187,114,.62); background: rgba(217,187,114,.12); color: #efd892; }

.tag { display: inline-flex; align-items: center; padding: 6rpx 12rpx; border-radius: 4rpx; background: rgba(155,135,232,.12); color: #c7bbf6; font-size: 19rpx; }
.tag.gold { background: rgba(217,187,114,.12); color: #efd892; }
.tag.safe { background: rgba(101,199,153,.12); color: #9be0ba; }
.tag.risk { background: rgba(239,125,131,.12); color: #ffb2b6; }

.field-label { display: block; margin-bottom: 12rpx; color: var(--muted); font-size: 22rpx; }
.input, .textarea {
  width: 100%;
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  background: rgba(6, 10, 22, .72);
  color: var(--text);
  font-size: 25rpx;
}
.input { height: 76rpx; padding: 0 22rpx; }
.textarea { min-height: 260rpx; padding: 20rpx 22rpx; line-height: 1.65; }
.placeholder { color: #59637b; }

.metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12rpx; }
.metric { min-height: 132rpx; padding: 22rpx; }
.metric-value { font-size: 38rpx; font-weight: 650; color: var(--text); }
.metric-label { margin-top: 8rpx; font-size: 20rpx; color: var(--muted); }

.progress-track { height: 8rpx; overflow: hidden; border-radius: 4rpx; background: rgba(255,255,255,.08); }
.progress-fill { height: 100%; border-radius: inherit; background: var(--gold); }

.two-buttons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.full-button { width: 100%; }
.spacer-bottom { height: 44rpx; }
