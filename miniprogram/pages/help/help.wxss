.faq-list { display: flex; flex-direction: column; gap: 10rpx; }.faq { padding: 22rpx; }.faq view { display: flex; justify-content: space-between; gap: 18rpx; }.faq view text:first-child { color: #f3f5f9; font-size: 23rpx; }.faq view text:last-child { color: #d9bb72; font-size: 27rpx; }.faq > text { display: block; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(177,194,226,.1); color: #929db3; font-size: 20rpx; line-height: 1.65; }

