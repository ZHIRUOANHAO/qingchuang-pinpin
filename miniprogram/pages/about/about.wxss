.about-core { position: relative; z-index: 2; display: flex; min-height: 88vh; flex-direction: column; align-items: center; justify-content: center; text-align: center; }.mark { display: flex; width: 148rpx; height: 148rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(217,187,114,.35); border-radius: 50%; color: #d9bb72; font-size: 30rpx; }.brand-name { margin-top: 30rpx; color: #f5f7fb; font-size: 40rpx; font-weight: 650; }.slogan { margin-top: 10rpx; color: #c5ae6e; font-size: 22rpx; }.intro { max-width: 600rpx; margin-top: 30rpx; color: #909bb1; font-size: 21rpx; line-height: 1.75; }.version { display: flex; width: 100%; margin-top: 36rpx; padding: 22rpx; justify-content: space-between; color: #8a95ab; font-size: 20rpx; }.version text:last-child { color: #dce1eb; }.boundary { max-width: 580rpx; margin-top: 24rpx; color: #626d84; font-size: 18rpx; line-height: 1.6; }
.about-links { display: grid; width: 100%; margin-top: 28rpx; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.about-links button { min-height: 72rpx; padding: 12rpx 8rpx; border: 1rpx solid rgba(177,194,226,.16); background: rgba(10,16,29,.66); color: #aab4c7; font-size: 18rpx; }.about-links button::after { border: 0; }
