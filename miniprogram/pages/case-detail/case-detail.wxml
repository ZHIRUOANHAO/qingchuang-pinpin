<view wx:if="{{item}}" class="detail-page">
  <galaxy-backdrop></galaxy-backdrop>
  <safe-top></safe-top>
  <view class="detail-header">
    <button size="mini" class="icon-button" aria-label="返回案例" bindtap="back"><image class="header-icon" src="/assets/icons/arrow-left.png"></image></button>
    <view class="title-block"><text class="eyebrow">CASE / {{item.id}}</text><text class="case-title">{{item.title}}</text></view>
    <button size="mini" class="icon-button {{favorite ? 'is-favorite' : ''}}" aria-label="{{favorite ? '取消收藏' : '收藏案例'}}" bindtap="toggleFavorite"><image class="header-icon" src="/assets/icons/bookmark.png"></image></button>
  </view>

  <block>
    <view class="business-brief">
      <text class="section-title">这到底是一门什么生意？</text>
      <text class="trade-label">卖什么</text><text class="trade-value">{{item.offer}}</text>
      <text class="trade-label">谁付钱</text><text class="trade-value">{{item.payer}}</text>
      <text class="trade-label">买点：为什么愿意付钱</text><text class="trade-note">分析，不是成交证明</text><text class="trade-value">{{item.purchaseReason}}</text>
    </view>
    <view class="business-brief">
      <text class="section-title">最后交付什么，钱怎么收？</text>
      <text class="trade-label">交付物</text><text class="trade-value">{{item.delivery}}</text>
      <text class="trade-label">收费方式</text><text class="trade-value">{{item.chargingModel}}</text>
      <text class="trade-label">钱的去向</text><text class="trade-value">{{item.moneyFlow}}</text>
      <text class="trade-label">起步需要的能力</text><text class="trade-value">{{item.entryRequirements}}</text>
      <text class="trade-note">低成本不等于零技能；实际到账与净利润尚未独立核实。</text>
    </view>
    <view class="transaction-story"><text class="section-title">从卖点到交付、收钱</text><view wx:for="{{item.nodes}}" wx:key="id" class="trade-step"><text class="trade-label">{{index + 1}}. {{item.name}}</text><text class="trade-value">{{item.method}}</text></view></view>
    <view class="dna-caption"><text class="section-title">商业 DNA · 辅助理解</text><text class="trade-note">图谱不代替上面的案例正文。</text></view>
    <dna-view id="dnaScene" items="{{item.displayNodes}}" score="{{item.score}}" has-score="{{item.hasScore}}" selected-id="{{selectedNode ? selectedNode.id : ''}}" covered="{{!!selectedNode}}" reduced-motion="{{reducedMotion}}" bindselect="selectNode"></dna-view>
    <view class="case-intel">
      <view class="section-heading"><view><text class="eyebrow">BUSINESS SEQUENCE</text><text class="section-title">七阶段商业链路</text></view><text class="tag safe">{{item.accessLabel}}</text></view>
      <text class="case-value">{{item.value}}</text>
      <view class="chain-flow"><view wx:for="{{chainSteps}}" wx:key="number" class="chain-step"><text class="step-number">{{item.number}}</text><text class="step-title">{{item.title}}</text></view></view>
      <view class="case-cost"><text>最小实验成本</text><text>{{item.costLabel}}</text></view>
      <view class="compliance"><text class="compliance-title">合规边界</text><text class="compliance-copy">{{item.compliance}}</text></view>
    </view>
    <view class="node-index">
      <view class="section-heading"><view><text class="eyebrow">{{nodeIndex.length}} CORE STAGES</text><text class="section-title">阶段资产卡</text></view></view>
      <view class="node-grid"><button wx:for="{{nodeIndex}}" wx:key="id" class="node-item {{selectedNode.id === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectNodeFromIndex" aria-label="{{item.name}}详情"><view class="node-dot" style="background:{{item.color}}"></view><text class="node-number">{{item.number}}</text><text class="node-name">{{item.name}}</text><text class="node-stage">{{item.stageLabel}}</text></button></view>
    </view>
    <view class="detail-actions two-buttons"><button class="secondary-button" bindtap="sendToCanvas">装配到画布</button><button class="primary-button" bindtap="openReport">查看验证方案</button></view>
    <node-detail-sheet node="{{selectedNode}}" bindclose="closeNode"></node-detail-sheet>
  </block>
  <view class="source-panel"><text class="section-title">依据与实验边界</text><text class="source-note">{{item.originalEvidence || item.evidenceLabel}}</text><text class="source-note">来源核验记录：{{item.evidenceCheckedOn}}。公开经营资料不等于成交或盈利证明；购买动机与七关是编辑分析，不是客户访谈结论。</text><text class="source-note">成本为整案实验口径，未对每个节点单独核算成本或风险。</text><button wx:for="{{item.sourceUrls}}" wx:key="*this" class="source-button" data-index="{{index}}" bindtap="copySource">复制来源 {{index + 1}}：{{item}}</button><text wx:if="{{!item.sourceUrls.length}}" class="source-note">暂无可复制的来源链接。</text></view>
</view>
<view wx:else class="detail-page"><safe-top></safe-top><status-view type="empty" title="案例不存在" description="这个链接没有对应案例，请返回案例库选择。" action-text="返回" bindaction="back"></status-view></view>
