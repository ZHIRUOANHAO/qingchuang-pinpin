.detail-page { position: relative; min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 24px); background: #050812; color: #f5f7fb; }
.business-brief, .transaction-story { position:relative; z-index:3; margin:16px; padding:20px; border:1px solid #344154; background:#0b121e; }
.trade-label { display:block; margin-top:18px; color:#efd892; font-size:14px; line-height:1.7; }
.trade-value { display:block; margin-top:8px; color:#f5f7fb; font-size:14px; line-height:1.85; }
.trade-note { display:block; margin-top:8px; color:#aab4c7; font-size:11px; line-height:1.7; }
.trade-step { padding-bottom:16px; border-bottom:1px solid #344154; }
.dna-caption { position:relative; z-index:3; padding:20px; }
.detail-header { position: relative; z-index: 3; display: grid; grid-template-columns: 42px minmax(0, 1fr) 42px; align-items: center; gap: 12px; min-height: 76px; padding: 12px 16px 16px; }
.detail-header .icon-button { width: 42px; height: 42px; font-size: 24px; }
.header-icon { display: block; width: 20px; height: 20px; pointer-events: none; }
.detail-header .is-favorite { border-color: #d9bb72; background: #2a251b; }
.title-block { min-width: 0; }
.eyebrow { display: block; font-size: 9px; line-height: 16px; color: #d9bb72; }
.case-title { display: block; margin-top: 3px; font-size: 17px; line-height: 1.4; font-weight: 650; overflow-wrap: anywhere; }
.evidence-summary { position: relative; z-index: 3; margin: 0 16px 16px; padding: 12px 16px; border-left: 2px solid #62c7d9; background: #0b1823; }
.evidence-title { display: block; color: #a7e4ec; font-size: 12px; line-height: 1.5; }
.evidence-boundary { display: block; margin-top: 4px; color: #aab4c7; font-size: 11px; line-height: 1.65; }
.case-intel, .node-index { position: relative; z-index: 3; padding: 26px 20px; border-bottom: 1px solid rgba(177,194,226,.16); }
.case-intel { background: rgba(10,16,25,.8); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.section-title { display: block; margin-top: 5px; font-size: 21px; line-height: 1.3; }
.case-value { display: block; margin: 16px 0 22px; color: #aab4c7; font-size: 13px; line-height: 1.8; }
.chain-step { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 12px; padding: 17px 0; border-top: 1px solid rgba(177,194,226,.16); }
.step-number { color: #7f8aa6; font-size: 10px; line-height: 20px; }
.step-title { font-size: 13px; line-height: 20px; color: #edf0f7; }
.case-cost { display: flex; justify-content: space-between; gap: 12px; padding: 18px 0; border-top: 1px solid rgba(177,194,226,.16); font-size: 12px; color: #d9bb72; }
.compliance-title { display: block; font-size: 12px; color: #ef9da1; }
.compliance-copy { display: block; margin-top: 8px; font-size: 12px; line-height: 1.8; color: #96a0b8; }
.node-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 18px; background: rgba(177,194,226,.16); border: 1px solid rgba(177,194,226,.16); }
.node-item { box-sizing: border-box; width: 100%; min-width: 0; min-height: 110px; margin: 0; padding: 14px 10px; border-radius: 0; background: #090f18; text-align: left; line-height: 1.4; }
.node-item::after { border: 0; }
.node-item.selected { background: #16202d; }
.node-dot { width: 8px; height: 8px; border-radius: 50%; }
.node-number { display: block; margin-top: 10px; color: #7f8aa6; font-size: 9px; }
.node-name { display: block; margin-top: 4px; color: #edf0f7; font-size: 13px; }
.node-stage { display: block; margin-top: 5px; color: #96a0b8; font-size: 10px; }
.detail-actions { position: relative; z-index: 3; padding: 20px 16px 0; }
.locked-intel { position: relative; z-index: 3; margin: 12px 16px 0; padding: 24px 20px; border: 1px solid rgba(217,187,114,.24); background: rgba(10,16,25,.92); }
.locked-title { display: block; margin-top: 14px; font-size: 22px; line-height: 1.4; font-weight: 650; }
.locked-meta { display: grid; gap: 8px; margin: 18px 0; padding: 16px 0; border-top: 1px solid rgba(177,194,226,.16); border-bottom: 1px solid rgba(177,194,226,.16); color: #96a0b8; font-size: 12px; line-height: 1.6; }
.availability-note { display:block; margin-top:20px; padding-top:16px; border-top:1px solid rgba(177,194,226,.16); color:#d9bb72; font-size:12px; line-height:1.8; }
.locked-actions { padding-top:0; }
.locked-actions .full-button + .full-button { margin-top:12px; }
.locked-note { display: block; margin-top: 12px; color: #aab4c7; font-size: 11px; line-height: 1.7; text-align: center; }
.source-panel { position:relative; z-index:3; margin:24px 16px; padding:20px; border:1px solid #344154; background:#0b121e; }
.source-panel .section-title { font-size:18px; }
.proof-source { margin-top:16px; padding-top:16px; border-top:1px solid #344154; }
.proof-label { display:block; color:#f5f7fb; font-size:14px; line-height:1.6; font-weight:600; }
.proof-meta { display:block; margin-top:5px; color:#a7e4ec; font-size:11px; line-height:1.7; }
.proof-url { display:block; margin-top:8px; color:#aab4c7; font-size:11px; line-height:1.6; overflow-wrap:anywhere; word-break:break-all; }
.source-note { display:block; margin-top:12px; color:#aab4c7; font-size:12px; line-height:1.8; }
.source-button { margin:12px 0 0; padding:10px; min-height:44px; color:#8cdcea; background:#101c2b; font-size:12px; line-height:1.8; text-align:left; overflow-wrap:anywhere; word-break:break-all; }
.source-button::after { border:0; }
