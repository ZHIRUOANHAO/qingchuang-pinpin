.cases-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  height: 100vh;
  min-height: 0;
  padding: 0 24rpx;
  overflow: hidden;
}
.cases-page > safe-top, .cases-page > .nav-bar, .filters { flex-shrink: 0; }
.cases-page .nav-bar { min-height: 96rpx; }
.cases-page .brand-block text { display: block; }
.cases-page .brand-sub { font-size: 22rpx; line-height: 1.45; }
.search {
  position: relative;
  z-index: 3;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  color: #aab4c7;
}
.search-icon { flex: none; width: 40rpx; font-size: 30rpx; }
.search input { flex: 1; min-width: 0; color: #f5f7fb; font-size: 26rpx; }
.search button { width: 54rpx; height: 54rpx; padding: 0; background: transparent; color: #aab4c7; }
.search button::after { border: 0; }
.access-filters {
  position: relative;
  z-index: 3;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 14rpx;
}
.access-note { flex: 1; min-width: 0; color: #aab4c7; font-size: 22rpx; line-height: 1.45; }
.access-filters button {
  flex: none;
  min-height: 64rpx;
  margin: 0;
  padding: 0 14rpx;
  background: transparent;
  color: #8cdcea;
  font-size: 22rpx;
  line-height: 1.3;
}
.access-filters button::after { border: 0; }
.filters { position: relative; z-index: 3; width: 100%; margin-top: 12rpx; }
.chip-row { padding: 0 0 14rpx; }
.list { position: relative; z-index: 2; flex: 1; min-height: 0; height: 0; margin-top: 2rpx; }
.case-list {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 14rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 8rpx 0 calc(env(safe-area-inset-bottom) + 24rpx);
}
.case-item {
  display: grid;
  grid-template-columns: 110rpx minmax(0, 1fr);
  gap: 20rpx;
  box-sizing: border-box;
  width: 100% !important;
  max-width: none;
  min-height: 230rpx;
  margin: 0;
  padding: 22rpx;
  color: inherit;
  text-align: left;
  line-height: 1.4;
}
.case-item::after { border: 0; }
.visual {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-right: 1rpx solid rgba(177,194,226,.1);
}
.case-body { min-width: 0; }
.case-head { display: flex; align-items: flex-start; gap: 16rpx; }
.case-title { min-width: 0; color: #f5f7fb; font-size: 28rpx; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
.access-label { display: block; margin-top: 8rpx; color: #65c799; font-size: 22rpx; line-height: 1.45; }
.access-label.paid { color: #d9bb72; }
.evidence-label { display: block; margin-top: 8rpx; color: #8cdcea; font-size: 21rpx; line-height: 1.45; }
.evidence-label.is-index { color: #efd892; }
.industry, .cost { display: block; margin-top: 8rpx; color: #a8b2c7; font-size: 22rpx; line-height: 1.45; }
.value {
  display: -webkit-box;
  margin-top: 12rpx;
  overflow: hidden;
  color: #bac4d5;
  font-size: 23rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.tag-row { display: flex; gap: 8rpx; margin-top: 14rpx; overflow: hidden; }
.case-item .tag { font-size: 20rpx; }
.loading-more { display: block; padding: 18rpx; color: #8d97ac; font-size: 21rpx; text-align: center; }
