<view class="page-shell custom-page cases-page">
  <galaxy-backdrop></galaxy-backdrop><safe-top></safe-top>
  <view class="nav-bar"><view class="brand-block"><text class="brand">轻创业案例库</text><text class="brand-sub">{{loading ? '正在筛选…' : '找到 ' + total + ' 个案例'}} · 看懂买家、卖点、交付与验证</text></view></view>
  <view class="search panel"><text class="search-icon" aria-hidden="true">⌕</text><input value="{{keyword}}" maxlength="80" confirm-type="search" aria-label="搜索案例或行业" placeholder="搜索案例或行业" placeholder-class="placeholder" bindinput="onSearch" bindconfirm="confirmSearch" /><button wx:if="{{keyword}}" class="clear-search" aria-label="清空搜索关键词" bindtap="clearSearch">×</button><button class="search-submit" aria-label="搜索并保存关键词" bindtap="confirmSearch">搜索</button></view>
  <view class="history-tools"><text class="history-local">搜索词与浏览足迹仅保存在本机</text><button class="history-link" bindtap="openHistory" aria-label="查看最近浏览的案例">最近浏览 ›</button></view>
  <view wx:if="{{historyError}}" class="search-history-error"><text>最近搜索暂不可用，不影响搜索案例。</text><button bindtap="loadSearchHistory" aria-label="重试读取最近搜索">重试</button></view>
  <view wx:elif="{{searchHistory.length && !keyword}}" class="search-history">
    <view class="history-heading"><text>最近搜索</text><button bindtap="clearHistory" aria-label="清空本机最近搜索">清空</button></view>
    <scroll-view class="search-history-scroll" scroll-x enhanced show-scrollbar="false"><view class="chip-row"><button wx:for="{{searchHistory}}" wx:key="*this" class="chip search-term" data-keyword="{{item}}" bindtap="searchAgain" aria-label="再次搜索{{item}}">{{item}}</button></view></scroll-view>
  </view>
  <view class="access-filters"><text class="access-note">全库免费 · 逐条展示来源与核对日期；索引线索单独标识，经营成效未经独立审计</text><button class="reset-filter" bindtap="resetFilters">重置筛选</button></view>
  <scroll-view class="filters" scroll-x enhanced show-scrollbar="false"><view class="chip-row"><button wx:for="{{tags}}" wx:key="*this" class="chip {{tag === item ? 'active' : ''}}" data-tag="{{item}}" bindtap="selectTag" aria-label="筛选{{item}}案例" aria-pressed="{{tag === item}}">{{item}}</button></view></scroll-view>

  <scroll-view class="list" scroll-y enhanced show-scrollbar="false" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="refresh" bindscrolltolower="loadMore">
    <status-view wx:if="{{loading}}" type="loading" title="正在读取案例宇宙"></status-view>
    <status-view wx:elif="{{error}}" type="error" title="案例读取失败" description="请重试，或重新打开本页" action-text="重新加载" bindaction="refresh"></status-view>
    <status-view wx:elif="{{!list.length}}" type="empty" title="没有匹配的案例" description="试试缩短关键词，或重置全部筛选" action-text="查看全部案例" bindaction="resetFilters"></status-view>
    <view wx:else class="case-list">
      <button wx:for="{{list}}" wx:key="id" class="case-item panel" data-id="{{item.id}}" bindtap="openCase" aria-label="打开{{item.title}}，免费全文">
        <view class="visual"><dna-mini tone="{{index % 2 ? 'violet' : 'gold'}}"></dna-mini></view>
        <view class="case-body"><view class="case-head"><text class="case-title">{{item.title}}</text></view><text class="access-label free">免费全文</text><text class="evidence-label {{item.sourceTier === 'official_index' ? 'is-index' : ''}}">{{item.sourceStatusLabel}} · {{item.evidenceCheckedOn}}</text><text class="industry">{{item.industry}} · {{item.difficultyLabel}}</text><text class="cost">{{item.costLabel}}</text><text class="value">卖什么：{{item.offer}}</text><text class="value">谁付钱：{{item.payer}}</text><view class="tag-row"><text wx:for="{{item.tags}}" wx:for-item="label" wx:key="*this" class="tag">{{label}}</text></view></view>
      </button>
      <ad-slot enabled="{{adSlot.enabled}}" unit-id="{{adSlot.unitId}}" placement="{{adSlot.placement}}" ad-type="{{adSlot.adType}}"></ad-slot>
      <text wx:if="{{list.length < total}}" class="loading-more">{{loadingMore ? '正在加载…' : '继续上滑加载'}}</text>
      <text wx:else class="loading-more">已显示全部案例</text>
      <view class="spacer-bottom"></view>
    </view>
  </scroll-view>
</view>
