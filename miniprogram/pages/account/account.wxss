.account-page { padding-bottom: 90rpx; }
.signed-out, .profile-form, .account-state { position: relative; z-index: 2; margin-top: 24rpx; padding: 28rpx; }
.signed-out { display: flex; min-height: 480rpx; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.avatar-placeholder { display: flex; width: 104rpx; height: 104rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(240,201,111,.35); border-radius: 50%; background: #152036; color: #f0d99d; font-size: 34rpx; }
.section-title, .section-copy { display: block; }.section-title { color: #f3f5f8; font-size: 27rpx; font-weight: 650; }.section-copy { margin-top: 8rpx; color: #8f99ae; font-size: 19rpx; line-height: 1.6; }.signed-out .section-title { margin-top: 28rpx; }.signed-out .section-copy { max-width: 520rpx; margin-bottom: 30rpx; }
.form-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }.sync-state { flex: 0 0 auto; padding: 7rpx 12rpx; border: 1rpx solid rgba(101,199,153,.28); border-radius: 4rpx; background: rgba(101,199,153,.08); color: #7dd9ad; font-size: 18rpx; }
.avatar-picker { position: relative; display: flex; width: 116rpx; height: 116rpx; margin: 32rpx auto; padding: 0; overflow: hidden; align-items: center; justify-content: center; border: 1rpx solid rgba(240,201,111,.34); border-radius: 50%; background: #152036; color: #f0d99d; font-size: 34rpx; }.avatar-picker::after { border: 0; }.avatar-picker image { width: 100%; height: 100%; }.avatar-edit { position: absolute; right: 0; bottom: 0; left: 0; padding: 6rpx 0 10rpx; background: rgba(5,8,18,.74); color: #f3f5f8; font-size: 16rpx; text-align: center; }
.field { padding: 22rpx 0; border-top: 1rpx solid rgba(177,194,226,.11); }.field-label { display: block; margin-bottom: 14rpx; color: #aab4c7; font-size: 20rpx; }.field input { height: 78rpx; padding: 0 20rpx; border: 1rpx solid rgba(177,194,226,.18); border-radius: 4rpx; background: rgba(8,13,25,.66); color: #f3f5f8; font-size: 23rpx; }.input-placeholder { color: #58637b; }
.role-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }.role-option { display: flex; min-width: 0; height: 68rpx; margin: 0; padding: 0 8rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(177,194,226,.16); border-radius: 4rpx; background: rgba(8,13,25,.58); color: #8f99ae; font-size: 18rpx; line-height: 1.2; }.role-option::after { border: 0; }.role-option.selected { border-color: rgba(240,201,111,.45); background: rgba(240,201,111,.09); color: #f0d99d; }
.save-button { margin-top: 16rpx; }
.account-state { margin-top: 18rpx; }.account-state > .section-title { margin-bottom: 16rpx; }.state-row { display: flex; min-height: 76rpx; align-items: center; justify-content: space-between; gap: 20rpx; border-top: 1rpx solid rgba(177,194,226,.1); color: #8f99ae; font-size: 20rpx; }.state-row text:last-child { color: #d7dce7; text-align: right; }.link-row text:last-child { color: #f0c96f; }
.account-actions { position: relative; z-index: 2; display: grid; gap: 12rpx; margin-top: 22rpx; }.danger-button { height: 84rpx; border: 1rpx solid rgba(239,125,131,.26); border-radius: 4rpx; background: rgba(239,125,131,.06); color: #ef9da1; font-size: 21rpx; }.danger-button::after { border: 0; }
@media (max-width: 340px) { .role-options { grid-template-columns: 1fr; } }
