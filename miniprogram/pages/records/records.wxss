.record-list { display: flex; flex-direction: column; gap: 12rpx; }.record { padding: 22rpx; }.record-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }.record-head text:first-child { color: #f5f7fb; font-size: 24rpx; font-weight: 600; }.record-head text:last-child { color: #68738b; font-size: 16rpx; }.record > text { display: block; margin-top: 12rpx; color: #929db4; font-size: 20rpx; line-height: 1.55; }.record-metrics { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }.record-metrics text { padding: 7rpx 10rpx; border-radius: 4rpx; background: rgba(217,187,114,.08); color: #d8c58f; font-size: 17rpx; }.record-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 20rpx; }
