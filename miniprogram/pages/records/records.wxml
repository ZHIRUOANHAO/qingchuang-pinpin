<view class="page-shell"><view class="nav-bar"><view class="brand-block"><text class="brand">案例演示记录</text><text class="brand-sub">回看预置案例并继续推进验证</text></view></view><status-view wx:if="{{!list.length}}" type="empty" title="还没有演示记录" description="在案例演示页选择一个内置案例并保存"></status-view><view wx:else class="section record-list"><view wx:for="{{list}}" wx:key="id" class="record panel"><view class="record-head"><text>{{item.title}}</text><text>{{item.time}}</text></view><text>{{item.summary}}</text><view class="record-metrics"><text>结构 {{item.nodes.length}} 节点</text><text>本地保存</text><text>来源可核对</text></view><view class="record-actions"><button class="secondary-button" data-index="{{index}}" bindtap="continueCanvas">继续拼装</button><button class="primary-button" data-index="{{index}}" bindtap="openValidation">查看验证方案</button></view></view></view></view>
