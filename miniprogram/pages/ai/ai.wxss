.mode-badge { padding: 8rpx 12rpx; border: 1rpx solid rgba(101,199,153,.3); border-radius: 4rpx; color: #9dd6b7; font-size: 17rpx; }
.notice { display: flex; margin-bottom: 22rpx; padding: 22rpx; flex-direction: column; gap: 10rpx; border-color: rgba(98,199,217,.24); color: #9aa6bb; font-size: 20rpx; line-height: 1.65; }
.notice-title { color: #dfe7f1; font-size: 23rpx; font-weight: 600; }
.case-picker { display: flex; min-height: 150rpx; padding: 24rpx; align-items: center; justify-content: space-between; gap: 20rpx; }
.case-picker view { min-width: 0; }
.case-picker text { display: block; }
.picker-label { color: #d9bb72; font-size: 17rpx; letter-spacing: .08em; }
.picker-title { margin-top: 10rpx; color: #edf1f7; font-size: 25rpx; font-weight: 600; line-height: 1.4; }
.picker-meta { margin-top: 8rpx; color: #78849c; font-size: 18rpx; }
.picker-arrow { flex-shrink: 0; color: #aeb8cb; font-size: 20rpx; }
.load-demo { margin-top: 20rpx; }
.quick-cases { margin-top: 34rpx; }
.quick-cases .section-title { display: block; margin-bottom: 14rpx; }
.quick-case { display: grid; width: 100%; min-height: 84rpx; margin: 10rpx 0; padding: 0 20rpx; grid-template-columns: minmax(0,1fr) auto auto; align-items: center; gap: 14rpx; text-align: left; }
.quick-case text:first-child { overflow: hidden; color: #dfe5ef; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.quick-case text:nth-child(2) { color: #718099; font-size: 17rpx; }
.quick-case text:last-child { color: #d9bb72; }
.analysis-state { position: relative; z-index: 2; display: flex; min-height: 72vh; flex-direction: column; align-items: center; justify-content: center; }
.pulse { display: flex; width: 150rpx; height: 150rpx; align-items: center; justify-content: center; border: 1rpx solid rgba(217,187,114,.38); border-radius: 50%; box-shadow: 0 0 80rpx rgba(98,199,217,.18), inset 0 0 40rpx rgba(217,187,114,.14); animation: pulse 1.5s ease-in-out infinite; }
.pulse text { color: #efd892; font-size: 30rpx; }
.analysis-title { margin-top: 34rpx; font-size: 29rpx; }
.steps { display: flex; margin-top: 26rpx; flex-direction: column; gap: 16rpx; color: #69748d; font-size: 20rpx; }
.steps .done { color: #9dd6b7; }
@keyframes pulse { 50% { transform: scale(1.05); opacity: .82; } }
.result-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.result-head > view { min-width: 0; }
.result-title { display: block; margin-top: 12rpx; color: #eef2f7; font-size: 29rpx; font-weight: 600; overflow-wrap: anywhere; }
.result-dna { margin: 20px -28rpx; }
.fact-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10rpx; }
.fact { min-width: 0; padding: 18rpx 10rpx; text-align: center; }
.fact text { display: block; }
.fact text:first-child { color: #d9bb72; font-size: 24rpx; font-weight: 600; }
.fact text:last-child { margin-top: 7rpx; color: #748198; font-size: 16rpx; }
.blueprint-grid { display: grid; grid-template-columns: 1fr 1fr; margin: 18rpx 0; border-top: 1rpx solid rgba(177,194,226,.16); border-left: 1rpx solid rgba(177,194,226,.16); }
.blueprint-grid view { min-height: 116rpx; padding: 18rpx; border-right: 1rpx solid rgba(177,194,226,.16); border-bottom: 1rpx solid rgba(177,194,226,.16); background: rgba(10,16,29,.72); }
.blueprint-grid text { display: block; }
.blueprint-grid text:first-child { color: #d9bb72; font-size: 17rpx; }
.blueprint-grid text:last-child { margin-top: 10rpx; color: #dfe4ed; font-size: 19rpx; line-height: 1.45; }
.source-panel { display: flex; margin: 18rpx 0; padding: 22rpx; flex-direction: column; gap: 12rpx; color: #909db2; font-size: 19rpx; line-height: 1.6; }
.source-panel button { min-height: 64rpx; margin: 0; border: 1rpx solid rgba(98,199,217,.2); background: rgba(98,199,217,.05); color: #91cbd5; font-size: 18rpx; }
.result-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.result-actions .primary-button { grid-column: 1 / -1; }
