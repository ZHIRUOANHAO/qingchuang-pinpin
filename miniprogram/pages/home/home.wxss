page { height:100%; overflow:hidden; }
.home-fixed { display:flex; flex-direction:column; position:relative; height:100vh; min-height:0; padding:0 14px 12px; overflow:hidden; }
.home-fixed > safe-top { display:block; flex:none; }
.nav-bar { flex:none; min-height:52px; gap:12px; }
.brand-block text { display:block; }
.brand { font-size:18px; }
.brand-sub { margin-top:5px; font-size:11px; line-height:1.5; }
.home-intro { position:relative; z-index:3; flex:none; padding:12px 0; }
.eyebrow { display:block; color:#d9bb72; font-size:11px; }
.home-title { display:block; margin-top:8px; color:#efd892; font-size:26px; font-weight:650; line-height:1.3; }
.home-description { display:block; margin-top:8px; color:#bac4d5; font-size:12px; line-height:1.7; }
.home-actions { display:grid; grid-template-columns:1.2fr 1fr; gap:8px; margin:12px 0; }
.home-actions button { min-height:44px; padding:8px; font-size:12px; }
.scope-note { display:block; color:#aab4c7; font-size:11px; line-height:1.65; }
.universe-viewport { position:relative; z-index:2; flex:1; min-height:0; width:100%; overflow:hidden; border:1px solid rgba(177,194,226,.2); border-radius:8px; }
.universe-viewport space-scene { display:block; width:100%; height:100%; }
.universe-caption { position:absolute; right:10px; bottom:12px; left:10px; z-index:3; pointer-events:none; }
.universe-caption text { display:block; margin-top:5px; color:#aab4c7; font-size:10px; line-height:1.5; }
@media (max-height:640px) {
  .home-intro { padding:6px 0; }
  .home-title { font-size:22px; }
  .home-description { display:none; }
  .home-actions { margin:8px 0; }
}
