page { height:100%; overflow:hidden; }
.home-fixed { display:flex; flex-direction:column; position:relative; height:100vh; min-height:0; padding:0 14px 12px; overflow:hidden; }
.home-safe-top { display:block; flex:none; }
.nav-bar { flex:none; min-height:52px; gap:12px; }
.brand, .brand-sub { display:block; }
.brand { font-size:18px; }
.brand-sub { margin-top:5px; font-size:11px; line-height:1.5; }
.home-intro { position:relative; z-index:3; flex:none; padding:12px 0; }
.eyebrow { display:block; color:#d9bb72; font-size:11px; }
.home-title { display:block; margin-top:8px; color:#efd892; font-size:26px; font-weight:650; line-height:1.3; }
.home-description { display:block; margin-top:8px; color:#bac4d5; font-size:12px; line-height:1.7; }
.home-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; margin:12px 0; }
.home-action { box-sizing:border-box !important; width:100% !important; max-width:100%; min-width:0; height:48px; min-height:48px; margin:0 !important; padding:0 !important; font-size:12px; line-height:1.5; white-space:nowrap; }
.scope-note { display:block; color:#aab4c7; font-size:11px; line-height:1.65; }
.scope-note-compact { display:none; }
.orbit-controls { position:relative; z-index:3; display:grid; flex:none; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px 8px; margin:0 0 8px; }
.orbit-state { display:block; grid-column:1 / -1; min-width:0; color:#aab4c7; font-size:10px; line-height:1.5; white-space:nowrap; }
.orbit-button { box-sizing:border-box !important; display:flex; width:100% !important; max-width:100%; min-width:0; height:44px; min-height:44px; margin:0 !important; align-items:center; justify-content:center; padding:0 !important; border:1px solid #344154; border-radius:6px; background:#101a2a; color:#efd892; font-size:11px; line-height:1.4; white-space:nowrap; }
.orbit-button.is-disabled { color:#96a0b8; background:#0b121e; }
.universe-viewport { position:relative; z-index:2; flex:1; min-height:0; width:100%; overflow:hidden; border:1px solid rgba(177,194,226,.2); border-radius:8px; }
.home-scene { display:block; width:100%; height:100%; }
.universe-caption { position:absolute; right:10px; bottom:12px; left:10px; z-index:3; pointer-events:none; }
.universe-caption-line { display:block; margin-top:5px; color:#aab4c7; font-size:10px; line-height:1.5; }
@media (max-height:640px) {
  .home-fixed { padding-bottom:8px; }
  .nav-bar { min-height:44px; }
  .home-intro { padding:4px 0; }
  .home-title { margin-top:4px; font-size:22px; }
  .home-description { display:none; }
  .home-actions { margin:8px 0; }
  .scope-note-full { display:none; }
  .scope-note-compact { display:block; }
}
@media (max-height:480px) and (min-width:600px) {
  .home-fixed { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.15fr); grid-template-rows:auto auto 1fr auto; column-gap:16px; }
  .home-safe-top { grid-column:1 / -1; }
  .nav-bar { grid-column:1; grid-row:2; }
  .home-intro { grid-column:1; grid-row:3; padding:4px 0; }
  .orbit-controls { grid-column:1; grid-row:4; margin-bottom:0; }
  .universe-viewport { grid-column:2; grid-row:2 / 5; height:100%; }
  .home-ad { grid-column:1 / -1; }
}
