.profile-page { padding-bottom: 120rpx; }.identity { position: relative; z-index: 2; display: grid; grid-template-columns: 104rpx 1fr auto; align-items: center; gap: 18rpx; margin-top: 28rpx; padding: 24rpx; }.avatar { display: flex; width: 88rpx; height: 88rpx; overflow: hidden; align-items: center; justify-content: center; border: 1rpx solid rgba(217,187,114,.28); border-radius: 50%; background: #17223c; color: #d9bb72; font-size: 32rpx; }.avatar image { width: 100%; height: 100%; }.identity-copy text { display: block; }.identity-copy text:first-child { color: #f5f7fb; font-size: 27rpx; font-weight: 600; }.identity-copy text:last-child { margin-top: 7rpx; color: #758098; font-size: 19rpx; }.login-action { padding: 0 18rpx; border: 1rpx solid rgba(217,187,114,.25); border-radius: 6rpx; background: rgba(217,187,114,.08); color: #efd892; font-size: 20rpx; }.login-action::after { border: 0; }
.membership { position: relative; z-index: 2; display: grid; grid-template-columns: 1fr auto; align-items: center; margin-top: 16rpx; padding: 26rpx; border-color: rgba(217,187,114,.2); }.membership-title, .membership-copy { display: block; }.membership-title { margin-top: 14rpx; color: #f0e2b6; font-size: 27rpx; font-weight: 600; }.membership-copy { margin-top: 8rpx; color: #8d8b7d; font-size: 19rpx; }.arrow { color: #d9bb72; font-size: 40rpx; }.asset-stats { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 20rpx; }.asset-stats view { text-align: center; }.asset-stats text { display: block; }.asset-stats text:first-child { color: #f5f7fb; font-size: 31rpx; font-weight: 600; }.asset-stats text:last-child { margin-top: 5rpx; color: #6f7a93; font-size: 18rpx; }
.menu { padding: 0 22rpx; }.menu-item { display: grid; grid-template-columns: 56rpx 1fr auto; align-items: center; gap: 14rpx; min-height: 116rpx; border-bottom: 1rpx solid rgba(177,194,226,.1); }.menu-item:last-child { border-bottom: 0; }.menu-symbol { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; color: #d9bb72; font-size: 24rpx; }.menu-item view text { display: block; }.menu-item view text:first-child { color: #e7eaf1; font-size: 23rpx; }.menu-item view text:last-child { margin-top: 6rpx; color: #68738b; font-size: 18rpx; }.menu-item > text:last-child { color: #58637b; font-size: 31rpx; }

