<scroll-view class="page-scroll" scroll-y enhanced show-scrollbar="false"><view class="page-shell custom-page profile-page"><galaxy-backdrop></galaxy-backdrop><safe-top></safe-top>
  <view class="nav-bar"><view class="brand-block"><text class="brand">个人中心</text><text class="brand-sub">本机商业学习档案</text></view><button class="icon-button" aria-label="设置" bindtap="openSettings">⚙</button></view>
  <view class="identity panel"><view class="avatar"><text>Q</text></view><view class="identity-copy"><text>本机档案</text><text>收藏、演示记录和方案只保存在当前设备</text></view></view>
  <view class="membership panel"><view><text class="tag gold">当前开放范围</text><text class="membership-title">100 条案例全部免费阅读</text><text class="membership-copy">无会员购买 · 无订单 · 无外部模型调用 · 广告未启用</text></view></view>
  <view class="asset-stats"><view><text>{{counts.favorites}}</text><text>收藏</text></view><view><text>{{counts.records}}</text><text>演示</text></view><view><text>{{counts.schemes}}</text><text>方案</text></view></view>
  <view class="section menu panel">
    <view wx:for="{{menus}}" wx:key="id" class="menu-item" data-url="{{item.url}}" bindtap="openMenu"><text class="menu-symbol">{{item.symbol}}</text><view><text>{{item.name}}</text><text>{{item.note}}</text></view><text>›</text></view>
  </view>
  <view class="section menu panel secondary-menu">
    <view class="menu-item" bindtap="shareMini"><text class="menu-symbol">↗</text><view><text>分享小程序</text><text>使用微信原生分享发送给好友</text></view><text>›</text></view>
    <view class="menu-item" data-url="/pages/privacy/privacy" bindtap="openMenu"><text class="menu-symbol">◎</text><view><text>隐私与权限</text><text>查看数据使用与权限说明</text></view><text>›</text></view>
    <view class="menu-item" data-url="/pages/help/help" bindtap="openMenu"><text class="menu-symbol">?</text><view><text>帮助中心</text><text>常见问题与使用支持</text></view><text>›</text></view>
    <view class="menu-item" data-url="/pages/about/about" bindtap="openMenu"><text class="menu-symbol">i</text><view><text>关于轻创拼拼</text><text>产品理念、合规边界与版本</text></view><text>›</text></view>
  </view><view class="spacer-bottom"></view>
</view></scroll-view>
