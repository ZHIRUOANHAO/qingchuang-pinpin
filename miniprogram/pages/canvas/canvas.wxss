.canvas-page { position: relative; min-height: 100vh; padding-bottom: calc(env(safe-area-inset-bottom) + 24px); background: #050812; color: #f5f7fb; }
.topbar { position: relative; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px 16px; min-height: 76px; }
.brand-block { flex: 1; min-width: 0; }
.brand { display: block; font-size: 17px; line-height: 1.45; overflow-wrap: anywhere; }
.brand-sub { display: block; margin-top: 4px; font-size: 11px; line-height: 1.5; }
.topbar .icon-button { width: 42px; height: 42px; font-size: 24px; }
.module-bar { position: relative; z-index: 3; width: 100%; }
.module-row { display: flex; gap: 8px; padding: 0 16px 16px; }
.module { box-sizing: border-box; flex: none; display: flex; align-items: center; gap: 8px; height: 40px; min-width: 92px; margin: 0; padding: 0 12px; border: 1px solid rgba(177,194,226,.16); border-radius: 4px; background: #0d1420; color: #aab4c7; font-size: 12px; line-height: 1; }
.module::after { border: 0; }
.module.added { border-color: rgba(217,187,114,.5); color: #efd892; }
.module-dot { width: 8px; height: 8px; border-radius: 50%; }
.data-drawer { position: relative; z-index: 3; padding: 20px 16px; border-bottom: 1px solid rgba(177,194,226,.16); background: #090f18; }
.drawer-head { display: flex; align-items: center; justify-content: space-between; width: 100%; margin: 0; padding: 0; background: transparent; color: #d9bb72; font-size: 24px; line-height: 1.5; text-align: left; }
.drawer-head::after { border: 0; }
.drawer-head .section-title { font-size: 17px; }
.metrics-line { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin: 20px 0; }
.metric-number, .metric-name { display: block; }
.metric-number { color: #efd892; font-size: 16px; font-weight: 600; overflow-wrap: anywhere; }
.metric-name { margin-top: 7px; color: #96a0b8; font-size: 10px; }
.drawer-content { padding-bottom: 20px; }
.advice, .missing { display: block; margin-top: 12px; font-size: 12px; line-height: 1.65; }
.advice { color: #aab4c7; }
.missing { color: #ef9da1; }
