.scheme-list { display: flex; flex-direction: column; gap: 12rpx; }.scheme { padding: 22rpx; }.scheme text { display: block; }.scheme-main { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }.scheme-main > view:first-child text:first-child { color: #f5f7fb; font-size: 24rpx; }.scheme-main > view:first-child text:last-child { margin-top: 7rpx; color: #6f7a93; font-size: 18rpx; }.scheme-main > view:last-child { text-align: right; }.scheme-main > view:last-child text:first-child { color: #efd892; font-size: 27rpx; }.scheme-main > view:last-child text:last-child { margin-top: 5rpx; color: #778299; font-size: 17rpx; }.scheme-actions { display: grid; grid-template-columns: 1fr 1fr 64rpx; gap: 10rpx; margin-top: 20rpx; }.scheme-actions button { min-width: 0; }
