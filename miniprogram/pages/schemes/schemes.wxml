<view class="page-shell"><view class="nav-bar"><view class="brand-block"><text class="brand">我的拼装方案</text><text class="brand-sub">保存、继续验证与阶段复盘</text></view></view><status-view wx:if="{{!list.length}}" type="empty" title="还没有方案" description="在画布中拼装节点并保存"></status-view><view wx:else class="section scheme-list"><view wx:for="{{list}}" wx:key="id" class="scheme panel"><view class="scheme-main"><view><text>{{item.title}}</text><text>{{item.time}} · {{item.nodes.length}} 个节点</text></view><view><text>{{item.metrics.completeness}}%</text><text>闭环完整度</text></view></view><view class="scheme-actions"><button class="secondary-button" data-index="{{index}}" bindtap="edit">继续编辑</button><button class="primary-button" data-index="{{index}}" bindtap="openValidation">验证方案</button><button class="icon-button" aria-label="删除方案" data-index="{{index}}" bindtap="remove">×</button></view></view></view></view>
