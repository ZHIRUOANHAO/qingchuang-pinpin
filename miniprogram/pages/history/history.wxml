<view class="page-shell history-page">
  <galaxy-backdrop></galaxy-backdrop>
  <view class="nav-bar"><view class="brand-block"><text class="brand">最近浏览</text><text class="brand-sub">{{list.length}} 条案例 · 本机最多保留 20 条</text></view></view>
  <view class="collection-toolbar"><text>按最近打开时间排列，方便接着查看。</text><button wx:if="{{list.length && !error}}" class="clear-all" bindtap="clearHistory" aria-label="清空本机全部浏览记录">清空记录</button></view>
  <status-view wx:if="{{error}}" type="error" title="浏览记录读取失败" description="本机存储暂不可用，请重试。" action-text="重新读取" bindaction="loadHistory"></status-view>
  <status-view wx:elif="{{!list.length}}" type="empty" title="还没有浏览记录" description="打开案例后，会在这里留下浏览足迹。" action-text="去看案例" bindaction="browseCases"></status-view>
  <view wx:else class="section history-list">
    <view wx:for="{{list}}" wx:key="id" class="history-item panel">
      <button class="open-item" data-id="{{item.id}}" bindtap="open" aria-label="继续查看：{{item.title}}"><view class="item-visual"><dna-mini></dna-mini></view><view class="item-copy"><text class="item-title">{{item.title}}</text><text class="item-meta">{{item.industry || '案例资料'}} · 查看案例 ›</text><text class="item-time">{{item.viewedAt}}</text></view></button>
      <button class="remove-item" data-id="{{item.id}}" bindtap="remove" aria-label="移除浏览记录：{{item.title}}">移除记录</button>
    </view>
  </view>
</view>
