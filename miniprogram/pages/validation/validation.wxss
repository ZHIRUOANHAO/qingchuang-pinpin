.validation-page { position: relative; min-height: 100vh; background: #050812; color: #f5f7fb; }.validation-shell { position: relative; z-index: 1; padding-bottom: calc(env(safe-area-inset-bottom) + 150rpx); }.validation-head { align-items: flex-start; }.progress-panel { margin-top: 18rpx; padding: 24rpx; }.progress-panel > view:first-child { display: flex; justify-content: space-between; color: #efd892; font-size: 22rpx; }.progress-panel > text { display: block; margin-top: 14rpx; color: #7e899f; font-size: 18rpx; }.answer-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1rpx solid rgba(177,194,226,.16); border-left: 1rpx solid rgba(177,194,226,.16); }.answer-grid view { min-height: 128rpx; padding: 20rpx; border-right: 1rpx solid rgba(177,194,226,.16); border-bottom: 1rpx solid rgba(177,194,226,.16); background: rgba(10,16,29,.7); }.answer-grid text { display: block; }.answer-grid text:first-child { color: #d9bb72; font-size: 17rpx; }.answer-grid text:last-child { margin-top: 12rpx; color: #e4e8f0; font-size: 21rpx; line-height: 1.5; }.metric-strip { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 24rpx; padding: 22rpx 10rpx; }.metric-strip view { text-align: center; border-right: 1rpx solid rgba(177,194,226,.13); }.metric-strip view:last-child { border-right: 0; }.metric-strip text { display: block; }.metric-strip text:first-child { color: #efd892; font-size: 25rpx; }.metric-strip text:last-child { margin-top: 6rpx; color: #6f7a93; font-size: 16rpx; }.day-list { display: flex; flex-direction: column; gap: 12rpx; }.day-item { border: 1rpx solid rgba(177,194,226,.15); background: rgba(10,16,29,.74); }.day-item.done { border-color: rgba(101,199,153,.32); }.day-main { display: grid; grid-template-columns: 48rpx 1fr; gap: 16rpx; padding: 20rpx; }.day-check { display: grid; place-items: center; width: 44rpx; height: 44rpx; border: 1rpx solid rgba(217,187,114,.35); color: #d9bb72; font-size: 18rpx; }.done .day-check { border-color: #65c799; background: rgba(101,199,153,.12); color: #65c799; }.day-main text { display: block; }.day-main text:first-child { font-size: 21rpx; }.day-main text:last-child { margin-top: 8rpx; color: #8d98ae; font-size: 18rpx; line-height: 1.5; }.day-item textarea { box-sizing: border-box; width: calc(100% - 40rpx); height: 92rpx; margin: 0 20rpx 20rpx; padding: 14rpx; border-top: 1rpx solid rgba(177,194,226,.12); color: #dfe4ed; font-size: 18rpx; }.boundary { display: grid; grid-template-columns: 120rpx 1fr; gap: 14rpx 16rpx; margin-top: 24rpx; padding: 22rpx; }.boundary text:nth-child(odd) { color: #d9bb72; font-size: 18rpx; }.boundary text:nth-child(even) { color: #98a3b8; font-size: 18rpx; line-height: 1.55; }.criteria { display: flex; flex-direction: column; border-top: 1rpx solid rgba(177,194,226,.15); }.criteria view { display: grid; grid-template-columns: 80rpx 1fr; gap: 16rpx; padding: 18rpx 8rpx; border-bottom: 1rpx solid rgba(177,194,226,.15); }.criteria text:first-child { color: #efd892; }.criteria text:last-child { color: #8e99af; line-height: 1.5; }.decision-buttons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 20rpx; }.decision-buttons button { border: 1rpx solid rgba(177,194,226,.18); border-radius: 5rpx; background: rgba(12,18,31,.8); color: #8c97ac; font-size: 20rpx; }.decision-buttons button::after { border: 0; }.decision-buttons button.active { border-color: rgba(217,187,114,.5); color: #efd892; }.validation-actions { position: fixed; z-index: 5; right: 24rpx; bottom: calc(env(safe-area-inset-bottom) + 20rpx); left: 24rpx; display: grid; grid-template-columns: .8fr 1.2fr; gap: 12rpx; padding: 14rpx; border: 1rpx solid rgba(177,194,226,.16); background: rgba(7,11,20,.94); backdrop-filter: blur(18rpx); }
